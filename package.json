    "minio": "^7.1.3",
    "multer": "^2.0.2",
    "nest-winston": "^1.10.2",
    "nestjs-cls": "^6.2.0",
    "nestjs-i18n": "^10.5.1",
    "nestjs-minio": "2.5.4",
    "nestjs-redis-client": "^1.0.4",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.17.2",
