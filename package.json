{
  "name": "nest-starter",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "ngrok": "./start-ngrok.sh",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:update": "npm run migration:run",
    "seed": "ts-node -r tsconfig-paths/register src/seed/seed-runner.ts",
    "seed:prod": "node dist/seed/seed-runner.js",
    "seed:docker": "docker exec -it server pnpm run seed",
    "k6-load-test": "./load-tests/run-k6-tests.sh",
    "k6-stress-test": "./load-tests/run-k6-tests.sh stress-test",
    "push:config": "./push-configs.sh",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:generate": "docker exec -it server pnpm typeorm-ts-node-commonjs migration:generate src/migrations/Migration -d src/data-source.ts",
    "migration:create": "docker exec -it server pnpm typeorm-ts-node-commonjs migration:create src/migrations/Migration",
    "migration:run": "docker exec -it server pnpm typeorm-ts-node-commonjs migration:run -d src/data-source.ts",
    "migration:revert": "docker exec -it server pnpm typeorm-ts-node-commonjs migration:revert -d src/data-source.ts",
    "migration:show": "docker exec -it server pnpm typeorm-ts-node-commonjs migration:show -d src/data-source.ts"
  },
  "dependencies": {
    "@fastify/basic-auth": "^6.2.0",
