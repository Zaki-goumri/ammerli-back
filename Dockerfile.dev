# syntax=docker/dockerfile:1

# Use the custom pre-built base image which includes Node, pnpm, and Chromium.
# Build it once with: docker build -t 3ammerli-base:latest -f Dockerfile.base .
FROM 3ammerli-base:latest

# Set working directory.
WORKDIR /usr/src/app

# Install nestjs/cli (this is specific to the project's dev tooling)
# pnpm is already installed in the base image.
RUN pnpm add -g @nestjs/cli

# Copy package files
COPY package.json pnpm-lock.yaml ./

# Install ALL dependencies (dev + prod) and persist them
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
  pnpm install --frozen-lockfile

# Copy source code
COPY . .

# Run the application as a non-root user.
# TODO: Change back to node user after fixing permission issues
# USER node

# Expose the port that the application listens on.
EXPOSE 3000

# Run the application in dev mode with hot-reload
CMD ["pnpm", "run", "start:dev"]